{
  "name": "patient-profile",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/features/patient/profile/src",
  "prefix": "ehr",
  "projectType": "library",
  "tags": ["type:feature", "scope:patient"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/features/patient/profile/ng-package.json",
        "tsConfig": "libs/features/patient/profile/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/features/patient/profile/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "setupFiles": ["libs/features/patient/profile/vitest-setup.ts"],
        "coverage": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "stylelint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "stylelint libs/features/patient/profile/**/*.scss"
      }
    }
  }
}
