{
  "name": "color-palette",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/features/color-palette/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/features/color-palette/ng-package.json",
        "tsConfig": "libs/features/color-palette/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/features/color-palette/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "setupFiles": ["libs/features/color-palette/vitest-setup.ts"],
        "coverage": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "stylelint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "stylelint libs/features/color-palette/**/*.scss"
      }
    }
  }
}
